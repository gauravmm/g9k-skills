#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "markdown-it-py",
#   "weasyprint",
#   "viwoods-sync @ git+https://github.com/gauravmm/viwoods-sync",
# ]
# ///
"""Markdown to a PDF sized for the Viwoods AiPaper, uploaded to its Learning section.

For reading written specs away from the desk. The page box is the screen's 3:4 shape at its
physical size, so the tablet's fit-to-width shows the type at the size it was set in.

The device has no delete verb and no overwrite: a second push of the same file makes `Name(1)`,
and only a hand on the tablet removes either. Every upload here is permanent.

The tablet's LAN Transfer app must be in the foreground. A woken tablet alone refuses the
connection.
"""

from __future__ import annotations

import argparse
import hashlib
import http.client
import json
import math
import os
import re
import secrets
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path

from markdown_it import MarkdownIt
from viwoods_sync import Client, DeviceError, DeviceUnreachable

# MagicDNS: the tablet is a Tailscale device, so this name resolves from any machine on the tailnet.
HOST = os.environ.get("VIWOODS_HOST", "http://viwoods-aipaper:8090")
SECTION = "APP_LEARNING"

# What this needs from the machine, and the one line that supplies it. Checked rather than assumed:
# a missing font substitutes silently, and the substitute is what the tablet would show.
FONTS = ("Charis SIL", "IBM Plex Sans", "IBM Plex Mono")
APT = (
    "sudo apt install -y libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fontconfig "
    "fonts-sil-charis fonts-ibm-plex fonts-noto-core poppler-utils"
)

# The screen's 3:4 shape at its physical size (spec/future/EPAPER-SEND.md in the varuag repo).
PAGE = "159mm 212mm"
# Top, sides, bottom. Set against the device, not on paper: the sides are as thin as the reader
# allows, and the top carries the clearance the tablet's own chrome takes.
MARGIN = "12.5mm 5mm 6mm"

# The device's own limits, which it does not enforce: it answers -104 and -102 instead.
NAME_CAP = 125
SIZE_CAP = 1 << 30

# 2 MiB, sequential, each chunk retried twice at a 300 s timeout. The device's web UI does the
# same and the protocol is not documented to allow anything else.
CHUNK = 2 * 1024 * 1024
TRIES = 3
POST_TIMEOUT = 300.0

# A sleeping tablet must cost the listing seconds, not the library default's three minutes. The
# upload itself keeps the long timeout: a multi-megabyte chunk needs the time a listing must not.
LIST_TIMEOUT = 8.0

# A push to a sleeping tablet becomes a detached retry loop, so nothing has to wait on the device.
# The deadline is a backstop against a forgotten process, not a policy: the pid is the kill switch.
RETRY_S = 60
DEADLINE_S = 24 * 3600


def _mins(seconds: int) -> str:
    count = max(1, seconds // 60)
    return f"{count} minute" + ("" if count == 1 else "s")


